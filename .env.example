# Copy to apps/api/.env and adjust as needed
DATABASE_URL=postgresql://lunaire:lunaire@localhost:5432/lunaire?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PORT=3000
WEB_ORIGIN=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
COOKIE_SECRET=change-me-cookie-secret-min-32-chars

# Frontend (apps/web/.env)
VITE_API_URL=http://localhost:3000/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
